# Nakili kuwa .env (bila kuweka .env kwenye Git!)
MJIBU_OLLAMA_URL=http://127.0.0.1:11434
MJIBU_MODEL=llama3.2:1b
MJIBU_K=4
MJIBU_LOAD=1

# Hifadhi ya vekta: auto (Chroma kama ipo) | chroma | tfidf
MJIBU_DB=auto
# Vipimo: auto (Ollama -> hashing) | ollama | hashing
MJIBU_EMBED=auto
MJIBU_EMBED_MODEL=llama3.2:1b

# LLM backend: ollama (ndani/bure) | openai (wingu - ukiwa na ufunguo)
MJIBU_BACKEND=ollama
MJIBU_OPENAI_URL=https://api.openai.com/v1
MJIBU_OPENAI_API_KEY=
MJIBU_OPENAI_MODEL=gpt-4o-mini
